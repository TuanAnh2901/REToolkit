{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retoolkit.dev/schemas/metadata_fixup.schema.json",
  "title": "retoolkit metadata fixup configuration",
  "description": "Profile-driven rules for rebuilding an obfuscated IL2CPP metadata header into a standard v31 file. Carries the transform contract only; game-specific values live in the profile data, never in source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "header_prefix", "header_offset", "header_length",
    "payload_start", "preserved_tail_start", "source_bias",
    "metadata_magic", "metadata_version", "xxtea_key", "mutations", "sections"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "header_prefix": { "type": "string", "pattern": "^[0-9a-f]+$" },
    "header_offset": { "type": "integer", "minimum": 0 },
    "header_length": { "type": "integer", "minimum": 1 },
    "payload_start": { "type": "integer", "minimum": 1 },
    "preserved_tail_start": { "type": "integer", "minimum": 0 },
    "source_bias": { "type": "integer", "minimum": 0 },
    "metadata_magic": { "type": "integer", "minimum": 1 },
    "metadata_version": { "type": "integer", "minimum": 1 },
    "xxtea_key": { "type": "string", "minLength": 16, "maxLength": 16 },
    "known_good_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "mutations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["swap", "xor"] },
          "a": { "type": "integer", "minimum": 0 },
          "b": { "type": "integer", "minimum": 0 },
          "offset": { "type": "integer", "minimum": 0 },
          "value": { "type": "integer", "minimum": 0, "maximum": 255 }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "name", "custom_offset_field", "custom_size_field"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "name": { "type": "string", "minLength": 1 },
          "custom_offset_field": { "type": "integer", "minimum": 0 },
          "custom_size_field": { "type": "integer", "minimum": 0 },
          "payload_transform": {
            "type": "object",
            "additionalProperties": false,
            "required": ["initial", "step"],
            "properties": {
              "initial": { "type": "integer", "minimum": 0, "maximum": 255 },
              "step": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
