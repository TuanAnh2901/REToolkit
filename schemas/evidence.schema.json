{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retoolkit.dev/schemas/evidence.schema.json",
  "title": "retoolkit evidence manifest",
  "description": "Append-only per-run record of hashed artifacts. Unlike canonical core JSON, manifests may contain resolved absolute paths and timestamps.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "records"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_name", "artifact_path", "sha256", "size", "stage", "timestamp"],
        "properties": {
          "logical_name": { "type": "string", "minLength": 1 },
          "artifact_path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0 },
          "stage": { "type": "string", "minLength": 1 },
          "tool": { "type": "string" },
          "tool_version": { "type": "string" },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_path": { "type": "string", "minLength": 1 },
              "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "timestamp": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" }
        }
      }
    }
  }
}
